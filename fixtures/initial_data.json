{
  "model": "pravaah.journal",
  "pk": 7,
  "fields": {
    "title": "Journal Writing Guide",
    "slug": "journal-writing-guide",
    "author": 3,
    "cover_image": "journal/import_covers/dan-counsell-zIwAchjDirM-unsplash_dWEshHR.jpg",
    "content": "<p class=\"\">PRAVAAH Journal — Writing Guide</p><ol class=\"numbered-list\"><li>Write entirely in Notion</li></ol><p class=\"\">You don't need to know:</p><p class=\"\">HTML<br>Markdown<br>programming<br>website design</p><p class=\"\">Just write your article normally.</p><ol class=\"numbered-list\"><li>Use normal Notion formatting</li></ol><p class=\"\">You can use:</p><p class=\"\">headings<br>paragraphs<br>bold<br>italic<br>links<br>quotes<br>bullet lists<br>numbered lists<br>tables<br>images<br>YouTube embeds<br>Vimeo embeds<br>3. Images</p><p class=\"\">Add photographs by upload,link or unsplash to your Notion article.</p><p class=\"\">Use good-quality photographs and make sure PRAVAAH has permission to publish them.</p><ol class=\"numbered-list\"><li>Videos</li></ol><p class=\"\">For videos, use:</p><p class=\"\">YouTube or Vimeo embeds.</p><p class=\"\">Do not upload large video files directly into the article.</p><ol class=\"numbered-list\"><li>Avoid special Notion features</li></ol><p class=\"\">For V1, don't use:</p><p class=\"\">databases<br>icons<br>cover image within notion<br>toggles<br>synced blocks<br>Notion pages embedded inside articles<br>interactive widgets<br>complicated third-party embeds<br>forms<br>anything that behaves more like an application than an article</p><figure class=\"image\"><a href=\"https://images.unsplash.com/photo-1455849318743-b2233052fcff?ixlib=rb-4.1.0&amp;q=85&amp;fm=jpg&amp;crop=entropy&amp;cs=srgb\"><img src=\"https://images.unsplash.com/photo-1455849318743-b2233052fcff?ixlib=rb-4.1.0&amp;q=85&amp;fm=jpg&amp;crop=entropy&amp;cs=srgb\"></a></figure><p class=\"\">\n</p>",
    "published_at": "2026-08-16T18:29:57Z",
    "created_at": "2026-08-16T18:30:07.057Z",
    "updated_at": "2026-08-16T18:30:07.057Z"
  }
},
