# PRAVAAH Production Environment Variables Template
# Copy these environment variables to Railway, Render, or your hosting provider

# Turn OFF debug mode in production (True for local development only)
DJANGO_DEBUG=False

# Set a secure secret key for production
SECRET_KEY=django-insecure-y(p&v3w3pnz*f%^_uo58=%_jd7ssry*g+n9eq#uha3yv2z5y(k

# Comma-separated list of allowed domain names (e.g. pravaah.up.railway.app,pravaah.onrender.com)
ALLOWED_HOSTS=pravaah.up.railway.app,pravaah.onrender.com,localhost,127.0.0.1,*

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://pravaah.up.railway.app,https://pravaah.onrender.com
